<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- ── Header ─────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="Let's set you up 👋"
            android:textColor="@color/primary"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:text="Skip"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ── Step indicator dots ────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <View
            android:id="@+id/stepDot1"
            android:layout_width="28dp"
            android:layout_height="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/dot_active" />

        <View
            android:id="@+id/stepDot2"
            android:layout_width="28dp"
            android:layout_height="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/dot_inactive" />

        <View
            android:id="@+id/stepDot3"
            android:layout_width="28dp"
            android:layout_height="6dp"
            android:background="@drawable/dot_inactive" />

        <TextView
            android:id="@+id/tvStepLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="Step 1 of 3"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ── Divider ─────────────────────────────────────────────── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="28dp"
        android:background="@color/divider" />

    <!-- ── STEP 1 · Monthly Income ─────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutStep1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💰"
            android:textSize="44sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="What's your average\nmonthly income?"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This helps us understand your financial baseline."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="28dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilIncome"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Monthly income"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/primary"
            app:prefixText="ZAR  ">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etIncome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="18sp" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <!-- ── STEP 2 · Monthly Expenses ───────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutStep2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧾"
            android:textSize="44sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="What's your average\nmonthly expense?"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Include rent, food, transport and regular bills."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="28dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilExpenses"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Monthly expenses"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/primary"
            app:prefixText="ZAR  ">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etExpenses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="18sp" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <!-- ── STEP 3 · Budget Goals ───────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutStep3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯"
                android:textSize="44sp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="What are your\nbudget goals?"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select all that apply. You can update these later."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="20dp"/>

            <!-- Goal checkboxes -->
            <CheckBox
                android:id="@+id/cbSavings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:button="@null"
                android:drawableEnd="@null"
                android:background="@drawable/checkbox_goal_bg"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="💵  Build Savings"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:layout_marginBottom="10dp"/>

            <CheckBox
                android:id="@+id/cbInvestments"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:button="@null"
                android:background="@drawable/checkbox_goal_bg"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="📈  Grow Investments"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:layout_marginBottom="10dp"/>

            <CheckBox
                android:id="@+id/cbEmergencyFund"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:button="@null"
                android:background="@drawable/checkbox_goal_bg"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="🛡️  Emergency Fund"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:layout_marginBottom="10dp"/>

            <CheckBox
                android:id="@+id/cbDebtRepayment"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:button="@null"
                android:background="@drawable/checkbox_goal_bg"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="🏦  Pay Off Debt"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:layout_marginBottom="10dp"/>

            <CheckBox
                android:id="@+id/cbRetirement"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:button="@null"
                android:background="@drawable/checkbox_goal_bg"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="🌅  Retirement Planning"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:layout_marginBottom="16dp"/>

            <!-- Custom goal -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCustomGoal"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Other goal (optional)"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCustomGoal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- ── Navigation buttons ──────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginEnd="12dp"
            android:text="← Back"
            android:textColor="@color/primary"
            android:visibility="invisible"
            app:cornerRadius="12dp"
            app:strokeColor="@color/primary"
            app:strokeWidth="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Next →"
            android:textSize="16sp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="12dp" />

    </LinearLayout>

</LinearLayout>